PORT=5000
MONGODB_URI=mongodb://localhost:27017/clothing_business
CLIENT_URL=http://localhost:3000


NODE_ENV=production
EXPOSE_DEV_OTP=false

# Cashfree Payment Gateway
# Get these from Cashfree Dashboard > Developers > API Keys
# Use your TEST/sandbox keys while developing, LIVE keys only in production.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# SANDBOX while testing, PRODUCTION when you go live
CASHFREE_ENV=SANDBOX